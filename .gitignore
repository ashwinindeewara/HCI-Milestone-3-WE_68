# ==========================================
# FreelanceFlow Workspace .gitignore
# ==========================================

# Dependencies
node_modules/
package-lock.json
yarn.lock
pnpm-lock.yaml

# Java / Spring Boot Build Artifacts
target/
backend/target/
*.class
*.jar
*.war
*.ear
*.zip
*.tar.gz
*.rar

# Expo / React Native Build & Cache
.expo/
frontend/.expo/
frontend/dist/
frontend/web-build/
expo-env.d.ts
*.tsbuildinfo

# Generated Native Folders
/ios
/android
frontend/ios
frontend/android

# Environment & Secrets
.env
.env.*
!.env.example
*.env.local

# IDE & Editor Files
.vscode/*
!.vscode/launch.json
!.vscode/settings.json
.idea/
*.iml
*.ipr
*.iws
.project
.classpath
.settings/
.springBeans
.sts4-cache/

# System & OS Files
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db

# Logs & Temporary Data
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
logs/
tmp/
scratch/
backend/data/
data/
*.db

